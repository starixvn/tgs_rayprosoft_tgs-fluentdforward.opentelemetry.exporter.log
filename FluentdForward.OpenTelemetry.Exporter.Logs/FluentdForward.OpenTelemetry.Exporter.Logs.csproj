<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion Condition="'$(TargetFramework)'=='net6.0' or '$(TargetFramework)'=='netstandard2.0'">10</LangVersion>
		<Version>0.4.0</Version>
		<Authors>Phoenix</Authors>
		<Company>Raypro</Company>
		<Copyright>Copyright © 2024 Lester</Copyright>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-fluentdforward.opentelemetry.exporter.log</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-fluentdforward.opentelemetry.exporter.log.git</RepositoryUrl>
		<PackageTags>OpenTelemetry Fluentd</PackageTags>
		<Description>Fluentd Forward for OpenTelemetry Log.</Description>
		<IsPackable>true</IsPackable>
		<PackageId>FluentdForward.OpenTelemetry.Exporter.Logs</PackageId>
		<RootNamespace>FluentdForward.OpenTelemetry.Exporter.Logs</RootNamespace>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<AssemblyVersion>0.4.0.0</AssemblyVersion>
		<FileVersion>0.4.0.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OpenTelemetry" Version="1.8.0" />
	</ItemGroup>

</Project>
